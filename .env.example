# Mercator Online account
MERCATOR_EMAIL=you@example.com
MERCATOR_PASSWORD=change-me

# Anthropic API key – optional, only to double-check replacements for discontinued products (README: "Where AI is used")
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Telegram (npm run bot)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DAILY_CHECK_AT=09:00
# RESTOCK_HORIZON_DAYS=7
# FREE_DELIVERY_EUR=60
# PAYMENT_METHOD=offlineCard     # pay on delivery: offlineCard or offlineCash – never online
# DELIVERY_NOTE=

# Concurrency: parallel requests to the shop (be polite – default 4)
# MERCATOR_CONCURRENCY=4

# Docker: the container runs as the owner of ./data automatically; set these only to force another user
# MERC_UID=1000
# MERC_GID=1000
