{
  "name": "merc-api-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mercator Online shopping agent that talks to the shop's web API directly – no browser",
  "license": "MIT",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "bot": "tsx src/bot.ts",
