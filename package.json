    "grammy": "^1.46.0",
    "linkedom": "^0.18.14",
    "tough-cookie": "^6.0.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
